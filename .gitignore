# Ignore everything by default
*

# Root files
!.gitignore
!index.html
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!justfile
!README.md
!scripts/
!scripts/*.py
!.github/
!.github/**
!LICENSE

# Docs assets (README demo GIF etc.)
!docs/
!docs/**

# Frontend source
!src/
!src/**

# Tauri (target/ は src-tauri/.gitignore で除外)
!src-tauri/
!src-tauri/.gitignore
!src-tauri/build.rs
!src-tauri/Cargo.toml
!src-tauri/Cargo.lock
!src-tauri/tauri.conf.json
!src-tauri/src/
!src-tauri/src/**
!src-tauri/icons/
!src-tauri/icons/**
!src-tauri/capabilities/
!src-tauri/capabilities/**

# VSCode recommended extensions only
!.vscode/
!.vscode/extensions.json

# Credentials, denied by exact name after the allows above so that an
# allowed directory cannot carry one in. Exact names rather than
# fragments: a *secret* pattern would also swallow a source file named
# after the feature it implements, and git add would skip it in silence.
.env
.env.*
**/secrets.json
**/secrets.yml
**/secrets.yaml
**/credentials.json
**/credentials.yml
**/credentials.toml
**/id_rsa
**/*.pem
**/*.key
**/apikey
.npmrc
